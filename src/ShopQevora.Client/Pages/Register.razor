@page "/register"
@inject NavigationManager Nav
<PageTitle>Create account — ShopQevora</PageTitle><section class="shell auth"><div class="panel"><span class="eyebrow">JOIN SHOPQEVORA</span><h1>Create an account</h1><p>Start building your personal collection. Passwords need uppercase and lowercase letters, a number, a symbol, and at least 8 characters.</p><form @onsubmit="Submit" @onsubmit:preventDefault><label for="email">Email</label><input id="email" type="email" autocomplete="email" required maxlength="254" @bind="email"/><label for="password">Password (8+ characters)</label><input id="password" type="@(showPassword?"text":"password")" autocomplete="new-password" required minlength="8" @bind="password"/><button type="button" class="text-button password-toggle" aria-pressed="@showPassword" @onclick="()=>showPassword=!showPassword">@(showPassword?"Hide password":"Show password")</button><button class="button button-primary full" disabled="@busy">@(busy?"Creating...":"Create account")</button></form><p class="error" role="alert">@error</p><p>Already registered? <a href="/login">Sign in</a></p></div></section>
@code{string email="",password="",error="";bool busy,showPassword;async Task Submit(){busy=true;try{error=await Shop.Register(email,password)??"";if(error=="")Nav.NavigateTo("/login");}catch{error="Unable to connect to the server.";}finally{busy=false;}}}
