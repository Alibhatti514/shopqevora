@implements IDisposable
@page "/orders"
<PageTitle>Orders — ShopQevora</PageTitle><section class="shell page"><span class="eyebrow">YOUR ACCOUNT</span><h1>Order history</h1>@if(Placed.HasValue && orders?.Any(x=>x.Id==Placed)==true){<div class="confirmation" role="status"><h2>Good things are in your order.</h2><p>Demo order #@Placed is confirmed. Your cart has been cleared. No payment was taken and no items will be shipped.</p></div>}@if(!Shop.LoggedIn){<p>Please <a href="/login">sign in</a> to see your orders.</p>}else if(orders==null){<p role="status">@(error==""?"Loading your orders…":"Orders are currently unavailable. Check the API connection or sign in again.")</p>}else if(orders.Count==0){<div class="empty"><h2>Your story starts here.</h2><p>No orders yet. Find something for your everyday.</p><a class="button button-primary" href="/#collection">Explore the collection ↗</a></div>}else{@foreach(var order in orders){<article class="order-card"><div><strong>Order #@order.Id</strong><span>@order.CreatedUtc.ToLocalTime().ToString("MMM d, yyyy")</span><strong>@order.Total.ToString("C")</strong></div><p>Demo order recorded · No payment collected · No fulfillment or tracking</p>@foreach(var line in order.Lines){<p>@line.ProductName × @line.Quantity — @((line.UnitPrice*line.Quantity).ToString("C"))</p>}</article>}}<p class="error" role="alert">@error</p></section>
@code{[SupplyParameterFromQuery(Name="placed")]public int? Placed{get;set;}List<Order>? orders;string error="";protected override async Task OnAfterRenderAsync(bool first){if(first){Shop.Changed+=Reload;await Load();}}void Reload()=>_ = Load();async Task Load(){if(Shop.LoggedIn){try{orders=await Shop.Orders();error="";}catch{error="Could not load orders.";}}await InvokeAsync(StateHasChanged);}public void Dispose()=>Shop.Changed-=Reload;}
