@page "/cart"
@implements IDisposable
@inject NavigationManager Nav
<PageTitle>Your bag — ShopQevora</PageTitle>
<section class="shell page"><span class="eyebrow">GOOD THINGS, GATHERED</span><h1>Your shopping bag.</h1>@if(Shop.Message!=""){<p class="notice" role="status">@Shop.Message</p>}@if(Shop.HasPendingGuestCart){<button class="button" @onclick="Merge">Retry guest bag merge</button>}
@if(items is null){<p role="status">@(error==""?"Gathering your selection…":"Your bag is temporarily unavailable.")</p>}
else if(items.Count==0){<div class="empty"><span class="empty-mark" aria-hidden="true">♡</span><h2>Room for something good.</h2><p>Your bag is empty. Find a little everyday inspiration.</p><a class="button button-primary" href="/#collection">Explore the collection ↗</a></div>}
else{<div class="cart-layout"><div>@foreach(var item in items){<article class="cart-row" @key="item.ProductID"><img src="@ProductPresentation.Image(item.Product)" alt="@item.Product.Name" width="135" height="160"/><div><span class="category">@item.Product.Category</span><h2>@item.Product.Name</h2><p>@Money(item.Product.Price) each · <strong>@Money(item.Product.Price*item.Quantity)</strong></p><div class="quantity-controls"><button type="button" class="quantity-button" aria-label="Decrease quantity of @item.Product.Name" disabled="@(busy||item.Quantity<=1)" @onclick="()=>Set(item,item.Quantity-1)">−</button><label class="sr-only" for="qty-@item.ProductID">Quantity for @item.Product.Name</label><input id="qty-@item.ProductID" class="qty" type="number" min="1" max="99" step="1" disabled="@busy" value="@item.Quantity" @onchange="e=>Quantity(item,e)"/><button type="button" class="quantity-button" aria-label="Increase quantity of @item.Product.Name" disabled="@(busy||item.Quantity>=99)" @onclick="()=>Set(item,item.Quantity+1)">+</button><button class="text-button" disabled="@busy" @onclick="()=>Remove(item)">Remove</button></div></div></article>}<a class="text-link" href="/#collection">← Continue exploring</a></div><aside class="summary"><span class="eyebrow">A CONSIDERED SELECTION</span><h2>Order summary</h2><div class="summary-line"><span>Subtotal (@items.Sum(x=>x.Quantity) items)</span><strong>@Money(Total)</strong></div><p>Demo checkout. No payment is taken. No tax, shipping, or fulfillment is applied.</p><div class="summary-line"><span>Total</span><strong>@Money(Total)</strong></div><button class="button button-primary full" @onclick="Checkout" disabled="@(busy||items.Any(i=>i.Product.Price<=0))">@(busy?"Please wait…":Shop.LoggedIn?"Place demo order ↗":"Continue to checkout ↗")</button><p>@(Shop.LoggedIn?"Your order is saved to your account.":"Your guest bag is saved on this browser. No account required.")</p></aside></div>}
@if(error!=""){<div class="error" role="alert">@error <button class="text-button" disabled="@busy" @onclick="Load">Try loading again</button></div>}</section>
@code {
 List<CartItem>? items;string error="";bool busy;decimal Total=>items?.Sum(x=>x.Product.Price*x.Quantity)??0;
 static string Money(decimal amount)=>amount.ToString("C",System.Globalization.CultureInfo.GetCultureInfo("en-US"));
 protected override async Task OnAfterRenderAsync(bool first){if(first){Shop.Changed+=Refresh;await Load();}}
 async Task Load(){try{items=await Shop.Cart();error="";}catch{error="Could not load your bag. Check the API connection or sign in again.";}await InvokeAsync(StateHasChanged);}
 void Refresh(){if(!busy)_=Load();}
 async Task Remove(CartItem i){if(busy)return;busy=true;error="";try{await Shop.Remove(i.ProductID);await Load();}catch{error="Unable to remove this item. Please try again.";}finally{busy=false;}}
 async Task Quantity(CartItem i,ChangeEventArgs e){if(int.TryParse(e.Value?.ToString(),out var n)&&n>=1&&n<=99)await Set(i,n);else error="Quantity must be a whole number from 1 to 99.";}
 async Task Set(CartItem i,int n){if(busy||n<1||n>99)return;busy=true;error="";try{await Shop.SetQuantity(i.ProductID,n);await Load();}catch{error="Could not update the quantity. Check your connection or sign in again.";}finally{busy=false;}}
 async Task Checkout(){if(!Shop.LoggedIn){Nav.NavigateTo("/checkout");return;}if(busy)return;busy=true;error="";try{var id=await Shop.Checkout();Nav.NavigateTo($"/orders?placed={id}");}catch{error="Could not confirm checkout. Reload your bag and check order history before trying again.";}finally{busy=false;}}
 async Task Merge(){try{await Shop.MergeGuestCart();await Load();}catch{error="Could not merge the guest bag. Your local items are preserved.";}}
 public void Dispose()=>Shop.Changed-=Refresh;
}
