@page "/"
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
@implements IAsyncDisposable
@using Microsoft.JSInterop
<PageTitle>ShopQevora — An elevated everyday.</PageTitle>

<HeroCarousel OnCollection="SelectCollection" />

<section class="brand-strip" aria-label="Our point of view"><div class="shell"><span>CONSIDERED DESIGN</span><span aria-hidden="true">✳</span><span>EVERYDAY POSSIBILITIES</span><span aria-hidden="true">✳</span><span>FIND YOUR OWN KIND OF GOOD</span></div></section>

<section class="shell discovery" id="collections">
    <div class="section-head"><div><span class="eyebrow">THE WORLD OF SHOPQEVORA</span><h2>A little discovery.<br/><em>A lot to love.</em></h2></div><p>From your first coffee to your last playlist.<br/>Find the pieces that make it yours.</p></div>
    <div class="category-grid">
        @foreach (var c in categories)
        {
            <a href="#collection" class="category-card" @onclick="() => SelectCollection(c.Name)"><img src="/images/products/@(c.Image).webp" alt="" width="600" height="750" loading="lazy"/><div><span><small>EXPLORE THE EDIT</small><h3>@ProductPresentation.CategoryLabel(c.Name)</h3></span><span class="category-arrow" aria-hidden="true">↗</span></div></a>
        }
    </div>
</section>

<section class="favorites-section" id="favorites"><div class="shell">
    <div class="section-head"><div><span class="eyebrow">BESTSELLERS · THE DEMO EDIT</span><h2>Good things. Great company.</h2></div><a class="text-link" href="#collection" @onclick="Clear">Shop all essentials ↗</a></div>
    <p class="section-note">Our handpicked favorites. Curated demo selections, rather than measured sales rankings.</p>
    @if (products is null) { <ProductSkeleton /> }
    else if (products.Count > 0) { <div class="product-grid">@foreach(var p in Favorites){<ProductCard @key="p.ProductID" Product="p" OnAdd="AddProduct" Badge="THE FAVORITES EDIT"/>}</div> }
    else { <p class="empty">The collection is currently unavailable. Please try loading it again below.</p> }
</div></section>

<section class="shell arrivals" id="new-arrivals">
    <div class="section-head"><div><span class="eyebrow">FRESH PERSPECTIVES</span><h2>Meet your new everyday.</h2></div><div class="arrivals-caption"><span class="edition-label">THE LATEST ADDITIONS</span><p><RevealText Text="A fresh take on the things you reach for." Mode="typing"/></p></div></div>
    @if (products is null) { <ProductSkeleton /> }
    else { <div class="product-grid">@foreach(var p in products.OrderByDescending(p=>p.ProductID).Take(4)){<ProductCard @key="p.ProductID" Product="p" OnAdd="AddProduct" Badge="NEW TO THE EDIT"/>}</div> }
</section>

<section class="editorial" id="story"><div class="editorial-image"><img src="/images/hero/home.webp" alt="A warm contemporary home with natural wood, sculptural furniture and soft textiles" loading="lazy" width="1920" height="1080"/></div><div class="editorial-copy"><span class="eyebrow">THE EVERYDAY, RECONSIDERED</span><h2>More meaning.<br/>Less ordinary.</h2><p>A favorite mug. The perfect light. A bag that goes everywhere. It's the little things that turn a routine into a ritual.</p><p>We bring together useful, beautiful pieces to make room for a little more joy in your day.</p><a href="#collection" class="button button-primary" @onclick='()=>SelectCollection("Home")'>Find your good thing <span aria-hidden="true">↗</span></a></div></section>

<section class="shell collection" id="collection">
    <div class="section-head"><div><span class="eyebrow">EXPLORE WITHOUT THE NOISE</span><h2><RevealText Text="The complete collection." Mode="words"/></h2></div><p>Considered pieces. Endless possibilities.</p></div>
    <div class="catalog-toolbar"><div class="search-wrap"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><label class="sr-only" for="search">Search products</label><input id="search" type="search" placeholder="Find your next favorite…" @bind="search" @bind:event="oninput"/></div><div class="select-wrap"><label for="category">Category</label><select id="category" @bind="category"><option value="">All collections</option>@foreach(var c in (products??[]).Select(p=>p.Category).Distinct().Order()){<option value="@c">@ProductPresentation.CategoryLabel(c)</option>}</select></div><div class="select-wrap"><label for="sort">Sort by</label><select id="sort" @bind="sort"><option value="featured">Our curated edit</option><option value="new">Newest additions</option><option value="low">Price: low to high</option><option value="high">Price: high to low</option><option value="name">Name: A–Z</option><option value="name-desc">Name: Z–A</option><option value="old">Oldest additions</option></select></div></div>
    <button @ref="filterButton" class="button" aria-expanded="@showFilters.ToString().ToLower()" aria-controls="price-filters" @onclick="OpenFilters">☷ Filters (@ActiveFilters)</button>
    @if(showFilters){<div class="drawer-backdrop" @onclick="CloseFilters"></div><aside class="account-drawer filter-drawer" @ref="filtersElement" role="dialog" aria-modal="true" aria-label="Product filters" @onkeydown="FilterKey"><div class="drawer-heading"><h2>Refine your edit.</h2><button class="text-button" aria-label="Close filters" @onclick="CloseFilters">Close ×</button></div><div class="filter-panel" id="price-filters"><label for="min-price">Minimum price ($)<input id="min-price" type="number" min="0" max="1000000" step="0.01" @bind="minPrice" @bind:event="oninput"/></label><label for="max-price">Maximum price ($)<input id="max-price" type="number" min="0" max="1000000" step="0.01" @bind="maxPrice" @bind:event="oninput"/></label><button class="text-button" @onclick="Clear">Clear All</button><p>Filters update instantly. Newest and oldest use catalog addition order.</p><button class="button button-primary" @onclick="CloseFilters">Show @Filtered.Count() results</button></div></aside>}
    <div class="filter-chips" role="group" aria-label="Selected filters">@if(search!=""){<button class="filter-chip" @onclick='()=>search=""'>Search: @search ×</button>}@if(category!=""){<button class="filter-chip" @onclick='()=>category=""'>@ProductPresentation.CategoryLabel(category) ×</button>}@if(minPrice.HasValue){<button class="filter-chip" @onclick="()=>minPrice=null">From $@minPrice ×</button>}@if(maxPrice.HasValue){<button class="filter-chip" @onclick="()=>maxPrice=null">Up to $@maxPrice ×</button>}</div>
    @if(products is null){<p class="catalog-loading" role="status">Finding your everyday favorites…</p><ProductSkeleton/>}
    else{
        <div class="results"><span role="status">@Filtered.Count() @(Filtered.Count()==1?"considered essential":"considered essentials")</span><button class="text-button" @onclick="Clear">Clear filters <span aria-hidden="true">×</span></button></div>
        <div class="product-grid">@foreach(var p in Filtered){<ProductCard @key="p.ProductID" Product="p" OnAdd="AddProduct"/>}</div>
        @if(!Filtered.Any()){<div class="empty"><span class="empty-mark" aria-hidden="true">⌕</span><h3>Nothing here just yet.</h3><p>Try a different search or explore all our collections.</p><button class="button button-primary" @onclick="Clear">Reset your search</button>@if(loadFailed){<button class="button" @onclick="Load">Reload collection</button>}</div>}
    }
    <p class="photo-disclaimer">An independent demo store. Product visuals are illustrative; no real payments or shipping.</p>
</section>

<section class="values-section"><div class="shell"><div class="values-heading"><span class="eyebrow">THE WAY WE SEE IT</span><h2>Small details.<br/><em>Everyday difference.</em></h2></div><div class="value-card"><span class="value-number">01</span><h3>Considered by design.</h3><p>Useful shapes, pleasing textures, and pieces that feel right in your everyday.</p></div><div class="value-card"><span class="value-number">02</span><h3>Your kind of good.</h3><p>Discover something that belongs in your world. Simple, individual, effortlessly you.</p></div><div class="value-card"><span class="value-number">03</span><h3>A little more ease.</h3><p>A clear collection, a saved bag, and a straightforward demo shopping experience.</p></div></div></section>

<div class="toast-region" aria-live="polite" aria-atomic="true">@if(message!=""){<div class="cart-toast"><span>@message</span><a href="/cart">View bag ↗</a><button class="text-button" @onclick='()=>message=""' aria-label="Dismiss notification">×</button></div>}</div>

@code {
    ElementReference filtersElement,filterButton; Microsoft.JSInterop.IJSObjectReference? filterModule;bool attachFilters;
    void OpenFilters(){showFilters=true;attachFilters=true;}
    async Task CloseFilters(){showFilters=false;if(filterModule is not null)await filterModule.InvokeVoidAsync("close");}
    async Task FilterKey(KeyboardEventArgs e){if(e.Key=="Escape")await CloseFilters();}
    protected override async Task OnAfterRenderAsync(bool first){if(attachFilters){attachFilters=false;filterModule??=await JS.InvokeAsync<Microsoft.JSInterop.IJSObjectReference>("import","./js/drawer.js");await filterModule.InvokeVoidAsync("open",filtersElement,filterButton);}}
    public async ValueTask DisposeAsync(){Shop.CatalogResetRequested-=ResetCatalog;if(filterModule is not null){await filterModule.InvokeVoidAsync("close");await filterModule.DisposeAsync();}}
    List<Product>? products;
    string search="", category="", sort="featured", message="";
    bool loadFailed,showFilters; decimal? minPrice,maxPrice; int ActiveFilters=>(search!=""?1:0)+(category!=""?1:0)+(minPrice.HasValue?1:0)+(maxPrice.HasValue?1:0);
    readonly (string Name,string Image)[] categories=[("Electronics","headphones"),("Home","vase"),("Fashion","hoodie"),("Accessories","sunglasses"),("Lifestyle","backpack"),("Workspace","organizer")];
    IEnumerable<Product> Filtered=>ProductPresentation.Filter(products??[],search,category,sort,minPrice,maxPrice);
    IEnumerable<Product> Favorites=>(products??[]).Where(p=>new[]{"Studio Headphones","Ceramic Coffee Cup","Everyday Backpack","Sunday Sunglasses"}.Contains(p.Name)).Take(4);
    void Clear(){search="";category="";sort="featured";minPrice=null;maxPrice=null;}
    void SelectCollection(string value){if(value=="favorites")return;search="";category=value;sort="featured";minPrice=null;maxPrice=null;}
    void ResetCatalog(){Clear();_ = InvokeAsync(StateHasChanged);}
    protected override Task OnInitializedAsync(){Shop.CatalogResetRequested+=ResetCatalog;return Load();}
    async Task Load(){products=null;loadFailed=false;try{products=(await Shop.Products()).Where(ProductPresentation.HasCatalogImage).ToList();}catch{products=[];loadFailed=true;}}
    async Task AddProduct(Product p){try{await Shop.Add(p.ProductID);message=$"{p.Name} is in your bag.";}catch{message="Could not update your bag. Check your connection or sign in again.";}}
}
