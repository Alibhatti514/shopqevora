@page "/login"
@inject NavigationManager Nav
<PageTitle>Sign in — ShopQevora</PageTitle><section class="shell auth"><div class="panel"><span class="eyebrow">WELCOME BACK</span><h1>Sign in</h1><p>Access your saved cart and orders. Guest items will merge into your account bag; shared products keep the larger quantity.</p><form @onsubmit="Submit" @onsubmit:preventDefault><label for="email">Email</label><input id="email" type="email" autocomplete="email" required maxlength="254" @bind="email"/><label for="password">Password</label><input id="password" type="@(showPassword?"text":"password")" autocomplete="current-password" required minlength="8" @bind="password"/><button type="button" class="text-button password-toggle" aria-pressed="@showPassword" @onclick="()=>showPassword=!showPassword">@(showPassword?"Hide password":"Show password")</button><button class="button button-primary full" disabled="@busy">@(busy?"Signing in...":"Sign in")</button></form><p class="error" role="alert">@error</p><p>New here? <a href="/register">Create an account</a></p></div></section>
@code{string email="",password="",error="";bool busy,showPassword;async Task Submit(){busy=true;try{error=await Shop.Login(email,password)??"";if(error=="")Nav.NavigateTo("/cart");}catch{error="Unable to connect to the server.";}finally{busy=false;}}}
