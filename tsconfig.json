{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "types": [
      "node"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
